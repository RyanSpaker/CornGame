/* CODEX — GPT-6.1 — 2026-11-05: reusable radio prop. Source Blender forward is -Y.
   PBR maps are baked by tools/bake_radio.py; KNOB/KNOB2 have local-Y spindle pivots.
   F switches held or placed; T/mouse tunes; E picks up; R drops. Starts on at 0.5.
   station_band is five percent of the complete dial on EACH side of a station.
   Replace temporary sounds below and RadioSignal sounds in lobby.corn with recordings. */
use lobby;
Visibility: Hidden;
Name: "radio";
Radio: {
  on: true; tuning: 0.5;
  volume: 0.65; static_gain: 0.55; station_band: 0.05; fade_seconds: 0.09;
  knob_degrees: 150; viewport_sweep: 0.95;
  source_forward: [0, -1, 0]; rear_gain: 0.3; distance_reference: 3; audio_range: 25;
  /* CODEX: Correct only tipped-over pickups, with a smooth one-shot turn toward the player. */
  pickup_tilt_degrees: 50; pickup_turn_seconds: 0.7;
  static_sound: "sounds/radio/static.ogg";
  stations: [
    { frequency: 0.1; sound: "sounds/radio/station_1.ogg"; gain: 1; },
    { frequency: 0.2; sound: "sounds/radio/station_2.ogg"; gain: 1; },
    { frequency: 0.3; sound: "sounds/radio/station_3.ogg"; gain: 1; },
    { frequency: 0.5; sound: "sounds/radio/station_4.ogg"; gain: 1; },
    { frequency: 0.8; sound: "sounds/radio/station_5.ogg"; gain: 1; }
  ];
}
Body: Static;
/* CODEX: plastic cabinet knock with a loose internal rattle, distinct from the metal props. */
KickSound: { sound: "sounds/kicks/radio.ogg"; gain: 0.9; }
FittedHull: { exclude_names: ["antenna"]; }
Restitution: { coefficient: 0.1; }
Holdable: { droppable: true; screen_height: 0.28; below: 0.16; depth_scale: 0.7; }
/* CODEX: Surface-hit reach exceeds the current 6m drop ray, so a fresh drop remains recoverable.
   The collider cursor cast gives this small object a forgiving target without seeing through walls. */
InteractionText: { name: "radio"; prompt: "pick up"; range: 6.5; cursor_cast: true; }
SeenTracker: { unseen_delay: 0.15; }
include "radio.gltf#Scene0" as child;
